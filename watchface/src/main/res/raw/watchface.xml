<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <UserConfigurations>
        <ListConfiguration
            id="scene"
            displayName="scene_setting_title"
            screenReaderText="scene_setting_description"
            defaultValue="0">
            <ListOption id="0" displayName="scene_bicycle" screenReaderText="scene_bicycle" icon="icon_scene_bicycle" />
            <ListOption id="1" displayName="scene_forest" screenReaderText="scene_forest" icon="icon_scene_forest" />
            <ListOption id="2" displayName="scene_coding" screenReaderText="scene_coding" icon="icon_scene_coding" />
            <ListOption id="3" displayName="scene_kitten" screenReaderText="scene_kitten" icon="icon_scene_kitten" />
            <ListOption id="4" displayName="scene_landscape" screenReaderText="scene_landscape" icon="icon_scene_landscape" />
            <ListOption id="5" displayName="scene_cosmos" screenReaderText="scene_cosmos" icon="icon_scene_cosmos" />
            <ListOption id="6" displayName="scene_ocean" screenReaderText="scene_ocean" icon="icon_scene_ocean" />
            <ListOption id="7" displayName="scene_aurora" screenReaderText="scene_aurora" icon="icon_scene_aurora" />
        </ListConfiguration>
        <ListConfiguration
            id="rotation_period"
            displayName="rotation_setting_title"
            screenReaderText="rotation_setting_description"
            defaultValue="60">
            <ListOption id="FIXED" displayName="rotation_fixed" screenReaderText="rotation_fixed" />
            <ListOption id="15" displayName="rotation_15" screenReaderText="rotation_15" />
            <ListOption id="30" displayName="rotation_30" screenReaderText="rotation_30" />
            <ListOption id="60" displayName="rotation_60" screenReaderText="rotation_60" />
            <ListOption id="180" displayName="rotation_180" screenReaderText="rotation_180" />
            <ListOption id="360" displayName="rotation_360" screenReaderText="rotation_360" />
            <ListOption id="1440" displayName="rotation_1440" screenReaderText="rotation_1440" />
        </ListConfiguration>
        <BooleanConfiguration
            id="motion_enabled"
            displayName="motion_setting_title"
            screenReaderText="motion_setting_description"
            defaultValue="TRUE" />
    </UserConfigurations>

    <BitmapFonts>
        <BitmapFont name="fold_time">
            <Character name="0" resource="clock_0" width="60" height="96" />
            <Character name="1" resource="clock_1" width="60" height="96" />
            <Character name="2" resource="clock_2" width="60" height="96" />
            <Character name="3" resource="clock_3" width="60" height="96" />
            <Character name="4" resource="clock_4" width="60" height="96" />
            <Character name="5" resource="clock_5" width="60" height="96" />
            <Character name="6" resource="clock_6" width="60" height="96" />
            <Character name="7" resource="clock_7" width="60" height="96" />
            <Character name="8" resource="clock_8" width="60" height="96" />
            <Character name="9" resource="clock_9" width="60" height="96" />
            <Character name=":" resource="clock_colon" width="20" height="96" />
        </BitmapFont>
    </BitmapFonts>

    <Scene>
        <!-- Rotation uses local date/time and changes only on interval boundaries. -->
        <Condition>
            <Expressions>
                <Expression name="show_bicycle"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "0" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 0]]></Expression>
                <Expression name="show_forest"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "1" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 1]]></Expression>
                <Expression name="show_coding"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "2" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 2]]></Expression>
                <Expression name="show_kitten"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "3" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 3]]></Expression>
                <Expression name="show_landscape"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "4" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 4]]></Expression>
                <Expression name="show_cosmos"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "5" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 5]]></Expression>
                <Expression name="show_ocean"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "6" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 6]]></Expression>
                <Expression name="show_aurora"><![CDATA[[CONFIGURATION.rotation_period] == "FIXED" ? [CONFIGURATION.scene] == "7" : (([CONFIGURATION.scene] * 1 + floor((((([YEAR] - 1970) * 365 + floor(([YEAR] - 1) / 4) - floor(([YEAR] - 1) / 100) + floor(([YEAR] - 1) / 400) - 477 + [DAY_OF_YEAR] - 1) * 1440 + [HOUR_0_23] * 60 + [MINUTE]) / [CONFIGURATION.rotation_period]))) % 8) == 7]]></Expression>
            </Expressions>
            <Compare expression="show_bicycle">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_bicycle" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_bicycle" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? ((([SECOND_MILLISECOND] % 10) / 10) * 720 - 300) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_bicycle" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 15 * sin(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 10 * cos(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_bicycle" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_forest">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_forest" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_forest" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 12 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_forest" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 20 * sin(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 12 * cos(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Transform target="alpha" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (40 + 215 * ((sin(rad(360 * ([SECOND_MILLISECOND] % 1))) + 1) / 2)) : 255' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_forest" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_coding">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_coding" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_coding" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 10 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_coding" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 15 * sin(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 10 * cos(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="blink_coding" />
                    <Transform target="alpha" value='[CONFIGURATION.motion_enabled] == "TRUE" ? ([SECOND_MILLISECOND] % 1.2 &lt; 0.6 ? 255 : 0) : 255' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_coding" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_kitten">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_kitten" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_kitten" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 18 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 8 * sin(rad(360 * ([SECOND_MILLISECOND] % 3) / 3)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_kitten" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (-350 + 720 * ([SECOND_MILLISECOND] % 8) / 8) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (-15 + 20 * sin(rad(180 * ([SECOND_MILLISECOND] % 8) / 8))) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_kitten" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_landscape">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_landscape" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_landscape" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 12 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_landscape" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 15 * sin(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 10 * cos(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_landscape" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_cosmos">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_cosmos" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_cosmos" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (-320 + 740 * ([SECOND_MILLISECOND] % 10) / 10) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (320 - 740 * ([SECOND_MILLISECOND] % 10) / 10) : 0' mode="TO" />
                    <Transform target="alpha" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (40 + 215 * ((sin(rad(360 * ([SECOND_MILLISECOND] % 1))) + 1) / 2)) : 255' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_cosmos" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (-320 + 740 * ([SECOND_MILLISECOND] % 10) / 10) : 0' mode="TO" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? (320 - 740 * ([SECOND_MILLISECOND] % 10) / 10) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_cosmos" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_ocean">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_ocean" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_ocean" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 25 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_ocean" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 12 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_ocean" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
            <Compare expression="show_aurora">
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="scene_aurora" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="drift_aurora" />
                    <Transform target="x" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 20 * sin(rad(360 * ([SECOND_MILLISECOND] % 10) / 10)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="motion_aurora" />
                    <Transform target="y" value='[CONFIGURATION.motion_enabled] == "TRUE" ? 12 * sin(rad(360 * ([SECOND_MILLISECOND] % 6) / 6)) : 0' mode="TO" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
                <PartImage x="0" y="0" width="450" height="450">
                    <Image resource="glass_aurora" />
                    <Variant target="alpha" value="0" mode="AMBIENT" />
                </PartImage>
            </Compare>
        </Condition>

        <DigitalClock x="0" y="155" width="450" height="102">
            <TimeText x="0" y="0" width="450" height="102" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
                <Variant target="tintColor" value="#FFF6EB" mode="AMBIENT" />
                <BitmapFont family="fold_time" size="96" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot
            slotId="0"
            displayName="date_slot_label"
            isCustomizable="TRUE"
            supportedTypes="LONG_TEXT SHORT_TEXT EMPTY"
            x="35" y="112" width="380" height="42">
            <DefaultProviderPolicy defaultSystemProvider="DAY_AND_DATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="380" height="42" cornerRadius="14" />
            <ScreenReader stringId="date_screen_reader">
                <Parameter expression="[COMPLICATION.TITLE]" />
                <Parameter expression="[COMPLICATION.TEXT]" />
            </ScreenReader>
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="380" height="42">
                    <Text align="CENTER" maxLines="1" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="28" weight="SEMI_BOLD" color="#FFF4E8">
                            <Shadow color="#CC11182E" offsetY="1" radius="2.5">
                                <Template><![CDATA[%s]]><Parameter expression='[COMPLICATION.TEXT] == "" ? "—" : [COMPLICATION.TEXT]' /></Template>
                            </Shadow>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="380" height="42">
                    <Text align="CENTER" maxLines="1" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="28" weight="SEMI_BOLD" color="#FFF4E8">
                            <Shadow color="#CC11182E" offsetY="1" radius="2.5">
                                <Template><![CDATA[%s %s]]><Parameter expression="[COMPLICATION.TITLE]" /><Parameter expression='[COMPLICATION.TEXT] == "" ? "—" : [COMPLICATION.TEXT]' /></Template>
                            </Shadow>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            slotId="1"
            displayName="left_slot_label"
            isCustomizable="TRUE"
            supportedTypes="SHORT_TEXT EMPTY"
            x="50" y="273" width="145" height="42">
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="145" height="42" cornerRadius="21" />
            <ScreenReader stringId="left_screen_reader">
                <Parameter expression="[COMPLICATION.TITLE]" />
                <Parameter expression="[COMPLICATION.TEXT]" />
            </ScreenReader>
            <Complication type="SHORT_TEXT">
                <PartImage x="2" y="9" width="24" height="24" tintColor="#FFF4E8">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="30" y="0" width="113" height="42">
                    <Text align="CENTER" maxLines="1" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="28" weight="BOLD" color="#FFF4E8">
                            <Shadow color="#CC11182E" offsetY="1" radius="2.5">
                                <Template><![CDATA[%s]]><Parameter expression='[COMPLICATION.TEXT] == "" ? "—" : [COMPLICATION.TEXT]' /></Template>
                            </Shadow>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            slotId="2"
            displayName="right_slot_label"
            isCustomizable="TRUE"
            supportedTypes="SHORT_TEXT EMPTY"
            x="255" y="273" width="145" height="42">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="145" height="42" cornerRadius="21" />
            <ScreenReader stringId="right_screen_reader">
                <Parameter expression="[COMPLICATION.TITLE]" />
                <Parameter expression="[COMPLICATION.TEXT]" />
            </ScreenReader>
            <Complication type="SHORT_TEXT">
                <PartImage x="2" y="9" width="24" height="24" tintColor="#FFF4E8">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="30" y="0" width="113" height="42">
                    <Text align="CENTER" maxLines="1" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="28" weight="BOLD" color="#FFF4E8">
                            <Shadow color="#CC11182E" offsetY="1" radius="2.5">
                                <Template><![CDATA[%s]]><Parameter expression='[COMPLICATION.TEXT] == "" ? "—" : [COMPLICATION.TEXT]' /></Template>
                            </Shadow>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
